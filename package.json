{
  "name": "mm-radar",
  "version": "1.0.0",
  "description": "M&M RADAR — ops system for M&M Insumos Neuquén (Cloudflare Workers + D1)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/local.ts",
    "dev:cf": "wrangler pages dev public --d1=DB=mm-radar-db --compatibility-date=2024-11-01",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/worker.js --platform=neutral --conditions=worker --external:cloudflare:*",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute mm-radar-db --local --file=migrations/0001_init.sql",
    "seed:commerce": "python3 scripts/seed-from-commerce.py",
    "export:commerce": "python3 scripts/seed-from-commerce.py",
    "typecheck": "tsc --noEmit",
    "refresh:local": "curl -s -X POST http://127.0.0.1:8787/api/refresh"
  },
  "keywords": [
    "mm-radar",
    "codineu",
    "neuquen"
  ],
  "author": "M&M Insumos",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "sql.js": "^1.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9",
    "wrangler": "3.112.0"
  }
}
